{
  "name": "hybrid-agent-rail",
  "version": "0.0.1",
  "description": "Hybrid Performance AI Harness Plugin. For (RN, Flutter, UniApp and Other Hybrid Framework)",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "pnpm -r --filter \"./package/*\" build",
    "test": "pnpm run test:workspace && pnpm run build && pnpm run test:smoke",
    "test:workspace": "node --test test/workspace.test.mjs",
    "test:smoke": "pnpm --filter hyar-example smoke"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yemomo511/hybrid-agent-rail.git"
  },
  "keywords": [
    "hybrid",
    "skill"
  ],
  "author": "yemomo511",
  "license": "ISC",
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.1.4",
    "rollup": "^4.53.3",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  },
  "bugs": {
    "url": "https://github.com/Yemomo511/hybrid-agent-rail/issues"
  },
  "homepage": "https://github.com/Yemomo511/hybrid-agent-rail#readme"
}
