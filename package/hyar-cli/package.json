{
  "name": "hyar-cli",
  "version": "0.0.1",
  "description": "CLI entry package for Hybrid Agent Rail.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "hyar": "./bin/hyar.mjs"
  },
  "files": [
    "bin",
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && rollup -c"
  },
  "dependencies": {
    "@clack/prompts": "^1.4.0",
    "cac": "^7.0.0",
    "hyar-adapter": "workspace:*"
  },
  "license": "ISC"
}
